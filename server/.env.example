# Copy this file to server/.env and replace every placeholder.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# MySQL connection. Create the database with: npm run db:migrate
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sanatan
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=sanatan
MYSQL_CONNECTION_LIMIT=10

# Browser origins allowed to submit forms. Use the exact production HTTPS origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for /api/admin/*. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
# Required in production (at least 32 characters). Used to pseudonymise IP addresses.
IP_HASH_SECRET=

# Set to the number of trusted reverse proxies (for example 1 behind nginx) in production.
TRUST_PROXY=0

# Optional: ClamAV daemon for CV scanning. CV uploads are rejected while this is empty.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Uploads are written with restrictive permissions; never serve this directory publicly.
UPLOAD_DIR=server/uploads/cv

# Abuse protection.
LEAD_RATE_LIMIT_WINDOW_MS=600000
LEAD_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_RATE_LIMIT_MAX=5
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=120

# CRM forwarding (server/src/crm.js). Leads are always stored in MySQL first; if set, each lead is
# also POSTed to the CRM, signed with HMAC-SHA256 (X-Sanatan-Signature). HTTPS only.
CRM_WEBHOOK_URL=
# At least 32 random characters, shared with the CRM receiver.
CRM_WEBHOOK_SECRET=
