# HTTPS entry point template.
#
# Usage:
#   1. Obtain a certificate (AWS ACM via an ALB is preferred; otherwise use certbot).
#   2. mkdir -p nginx/certs
#      cp /etc/letsencrypt/live/example.com/fullchain.pem nginx/certs/
#      cp /etc/letsencrypt/live/example.com/privkey.pem  nginx/certs/
#   3. Set server_name to your domain and copy this file over nginx/conf.d/default.conf.
#   4. In docker-compose.yml uncomment the 443 port mapping and the ./nginx/certs volume,
#      then run: docker compose up -d --build
#   5. Set SITE_URL and NEXT_PUBLIC_SITE_URL to https://example.com and ENABLE_HSTS=true.

# Keep the client-facing scheme when TLS is terminated earlier in the chain.
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    http    http;
    https   https;
}

upstream sanatan_web {
    server web:3000;
    keepalive 16;
}

upstream sanatan_api {
    server api:4000;
    keepalive 8;
}

server {
    listen 80 default_server;
    server_name example.com www.example.com;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name example.com www.example.com;
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 8m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /api/health {
        proxy_pass http://sanatan_api;
    }

    location ^~ /api/leads {
        proxy_pass http://sanatan_api;
    }

    location ^~ /api/admin {
        proxy_pass http://sanatan_api;
    }

    location / {
        proxy_pass http://sanatan_web;
    }
}
