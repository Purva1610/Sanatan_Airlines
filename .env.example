# Public values only. Never place API keys or secrets in NEXT_PUBLIC_* variables.
# Set these to the public URL served by nginx, without a trailing slash.
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Public contact details are intentionally blank until approved.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Enable only when the production host is confirmed to serve HTTPS throughout.
ENABLE_HSTS=false

# Same-origin API path proxied by nginx. Use an absolute URL only when the API
# is served from a different origin.
NEXT_PUBLIC_LEAD_API_URL=/api/leads

# Enable only after the approved Privacy Policy is published.
NEXT_PUBLIC_PRIVACY_POLICY_APPROVED=false

# Configure an approved WhatsApp Business number as international digits without +.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics requires both this ID and explicit user consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-side AI assistant using an OpenAI-compatible chat completions API.
# Keep the key server-side only; never prefix it with NEXT_PUBLIC_.
# Leave AI_API_KEY empty to serve published-information answers without a model.
AI_ASSISTANT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# JSON array of approved partner-supported destinations; keep empty until confirmed.
NEXT_PUBLIC_CONFIRMED_DESTINATIONS=[]

# ── Enquiry form integrations ─────────────────────────────────
# Webhook URL — receives every lead as a JSON POST (Zapier, Make, n8n, Google Sheets via Apps Script)
ENQUIRY_WEBHOOK_URL=

# Email address to notify on each new enquiry (requires a mail provider like Resend/SendGrid)
ENQUIRY_NOTIFY_EMAIL=

# HubSpot — set all three to enable HubSpot Forms API lead creation
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Zoho CRM — set to a Zoho webhook URL to push leads into Zoho
ZOHO_LEADS_WEBHOOK=


# Global CTA system (src/contactConfig.js). Each control is shown only when its value is set.
# Member login: an internal route (/members/login) or an https:// URL.
NEXT_PUBLIC_MEMBER_LOGIN_URL=
# Social profiles (https:// URLs). Unset channels are not rendered.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Optional medical-flight desk shown in the air ambulance emergency notice. Set ONLY if staffed 24/7.
NEXT_PUBLIC_AIR_AMBULANCE_PHONE=

# About / Contact / Grievance (src/contactConfig.js). Each value is shown only when set.
# Business hours exactly as the office keeps them, e.g. "Monday–Saturday, 10:00–18:00 IST"
NEXT_PUBLIC_BUSINESS_HOURS=
# Grievance: a ROLE mailbox (e.g. grievance@…), never a personal address. Officer name only with their consent.
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
# Company registration (shown under Governance on /about)
NEXT_PUBLIC_COMPANY_CIN=
NEXT_PUBLIC_COMPANY_GSTIN=
